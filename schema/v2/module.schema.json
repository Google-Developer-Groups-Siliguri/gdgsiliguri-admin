{
  "$id": "https://gdgsiliguri.com/schema/v2/module.schema.json",
  "title": "Module",
  "x-schema-version": 2,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "cards",
        "gallery",
        "links",
        "richText",
        "showcase",
        "blogs"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "subtitle": {
      "type": "string",
      "maxLength": 200
    },
    "icon": {
      "type": "string",
      "maxLength": 60
    },
    "edition": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "items"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inline"
            },
            "body": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "required": [
            "kind",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "showcase"
            },
            "edition": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "featuredOnly": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "blogs"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "placement": {
      "type": "object",
      "properties": {
        "app": {
          "type": "object",
          "properties": {
            "slot": {
              "type": "string",
              "enum": [
                "homeCard",
                "eventSection",
                "aboutSection",
                "tab",
                "none"
              ]
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "slot",
            "order"
          ],
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "properties": {
            "slot": {
              "type": "string",
              "enum": [
                "page",
                "homeSection",
                "devfestSection",
                "none"
              ]
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "path": {
              "type": "string",
              "pattern": "^\\/[a-z0-9]+(?:[-/][a-z0-9]+)*$"
            }
          },
          "required": [
            "slot",
            "order"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "app",
        "web"
      ],
      "additionalProperties": false
    },
    "minAppBuild": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "type",
    "title",
    "source",
    "placement",
    "enabled"
  ],
  "additionalProperties": false
}
