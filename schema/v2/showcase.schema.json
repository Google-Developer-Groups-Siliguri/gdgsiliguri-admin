{
  "$id": "https://gdgsiliguri.com/schema/v2/showcase.schema.json",
  "title": "Showcase",
  "x-schema-version": 2,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "body": {
      "type": "string",
      "maxLength": 5000
    },
    "team": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "links": {
            "type": "object",
            "properties": {
              "website": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "linkedin": {
                "type": "string"
              },
              "x": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              },
              "facebook": {
                "type": "string"
              },
              "youtube": {
                "type": "string"
              },
              "medium": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "demo": {
          "type": "string"
        },
        "video": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "images": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "url",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "edition": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "eventId": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "title",
    "summary",
    "team",
    "featured",
    "order"
  ],
  "additionalProperties": false
}
