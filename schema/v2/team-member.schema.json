{
  "$id": "https://gdgsiliguri.com/schema/v2/team-member.schema.json",
  "title": "TeamMember",
  "x-schema-version": 2,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "role": {
      "type": "string",
      "enum": [
        "organizer",
        "volunteer",
        "alumni"
      ]
    },
    "headline": {
      "type": "string",
      "maxLength": 200
    },
    "photo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "active": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "name",
    "role",
    "photo",
    "active",
    "order"
  ],
  "additionalProperties": false
}
