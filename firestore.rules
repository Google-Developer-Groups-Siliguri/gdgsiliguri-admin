rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{document=**} { allow read, write: if false; }
    match /content/{document=**} { allow read, write: if false; }
    match /auditLog/{document=**} { allow read, write: if false; }
    match /settings/{document=**} { allow read, write: if false; }

    // Pre-existing collections owned by another app; left exactly as they were (open) until their owner is known.
    match /appConfig/{document=**} { allow read, write: if true; }
    match /events/{document=**} { allow read, write: if true; }
    match /site/{document=**} { allow read, write: if true; }
  }
}
